{
  "cli": {
    "version": ">= 10.0.0"
  },
  "installCommand": "npm install --legacy-peer-deps",
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://NoteLoom-devops-noteloom-backend.hf.space"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://NoteLoom-devops-noteloom-backend.hf.space"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
