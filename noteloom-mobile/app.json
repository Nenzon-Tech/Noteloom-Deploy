{
  "expo": {
    "name": "NoteLoom",
    "slug": "noteloom",
    "version": "1.0.0",
    "scheme": "noteloom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nenzontech.noteloom"
    },
    "android": {
      "package": "com.nenzontech.noteloom",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1f2937",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock NoteLoom"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9333ea"
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "NoteLoom accesses your photos to let you share them with your friends."
        }
      ],
      "expo-document-picker",
      "expo-file-system"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46a78645-0e68-4a05-b363-2dc5a7bfa5e2"
      }
    }
  }
}
